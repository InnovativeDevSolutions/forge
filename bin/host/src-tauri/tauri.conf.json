{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "FORGE Host",
    "version": "0.1.0",
    "identifier": "com.idsolutions.forge.host",
    "build": {
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "FORGE Host",
                "width": 1280,
                "height": 720,
                "minWidth": 980,
                "minHeight": 640,
                "maximizable": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
