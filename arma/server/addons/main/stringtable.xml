        </Key>
        <Key ID="STR_forge_server_main_flushTimeout">
            <English>Shutdown Save Timeout (ms)</English>
        </Key>
        <Key ID="STR_forge_server_main_flushTimeoutTooltip">
            <English>At mission end the server waits up to this long for database writes to finish before shutting down.</English>
        </Key>
